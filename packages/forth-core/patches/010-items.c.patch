+      if(forthCapIsInteractive() && func > 0) {
+        /* func > 0 is LOAD-BEARING, not defensive: determineItem returns
+         * NEGATIVE softmenu ids (e.g. -MNU_AIMCATALOG, src/c47/assign.c:46)
