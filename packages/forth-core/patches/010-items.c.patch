+            if(calcMode == CM_PEM) {
+              insertUserItemInProgram(func, varCatalogItem);
+            }
+            else {
+              reallyRunFunction(ITM_FCALL, resolvedParam);
+            }
+          }
+          else if (res == FORTH_XEQ_ITEM) {
