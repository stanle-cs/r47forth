+        for (i = 0; i < nNames; i++) {
+          int16_t len = stringByteLength(tmpString + 15 * i) + 1;
+          xcopy(ptr, tmpString + 15 * i, len);
+          ptr += len;
+        }
+
+        dynamicSoftmenu[menu].numItems = nNames;
