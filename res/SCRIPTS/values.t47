# Demonstration of reg, var, and flag commands for T47 DSL

# --- Register Get/Set Operations ---

# Set a register to a value
reg 00 "1.234"

# Get the value of a register
set r [reg 00]
puts "Register 00 contains: $r"

# Setting returns new value
set newval [reg 00 "5.678"]
puts "New value set: $newval"

# Lettered registers work too
reg A "42"
set a [reg A]

# --- Variable Get/Set Operations ---

# Create and set a named variable (numeric)
var "myvalue" "3.14159"

# Get the named variable
set v [var "myvalue"]
puts "Named variable myvalue = $v"

# Setting returns new value  
set new_var [var "myvalue" "2.718"]
puts "New value set: $new_var"

# Lettered registers via var command
var B "100"
set b [var B]

# --- Flag Get/Set Operations ---

# Get flag state (returns 1 or 0)
set f0 [flag 0]
puts "Flag 0 state: $f0"

# Set a flag, returns new state
set new_flag [flag 5 1]
puts "New flag 5 state: $new_flag"

# Clear a flag
set cleared [flag 5 0]

# --- Summary Output ---
puts "\n=== Final State ==="
puts "R00: [reg 00]"
puts "RA:  [reg A]"
puts "RB:  [reg B]"
puts "myvalue: [var myvalue]"
puts "Flag 5: [flag 5]"

# Test complex numbers (if supported)
# Note: Complex number support requires NIM buffer parsing which is still in progress
