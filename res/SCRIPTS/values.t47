# Demonstration of reg, var, and flag commands for T47 DSL

# --- Register Get/Set Operations ---

# Set a register to a value and print it directly (round-trip)
reg 00 "1.234"
puts "Register 00 contains: [reg 00]"

# Setting returns new value
puts "New value set: [reg 00 "5.678"]"

# Lettered registers work too
reg A "42"
puts "RA = [reg A]"

# --- Variable Get/Set Operations ---

# Create and set a named variable (numeric), print directly (round-trip)
var "myvalue" "3.14159"
puts "Named variable myvalue = [var myvalue]"

# Setting returns new value
puts "New value set: [var myvalue "2.718"]"

# Lettered registers via var command
var B "100"
puts "RB = [var B]"

# --- Flag Get/Set Operations ---

# Get flag state (returns 1 or 0)
set f0 [flag 0]
puts "Flag 0 state: $f0"

# Set a flag, returns new state
set new_flag [flag 5 1]
puts "New flag 5 state: $new_flag"

# Clear a flag
set cleared [flag 5 0]

# --- Summary Output ---
puts "\n=== Final State ==="
puts "R00: [reg 00]"
puts "RA:  [reg A]"
puts "RB:  [reg B]"
puts "myvalue: [var myvalue]"
puts "Flag 5: [flag 5]"

# Test complex numbers (if supported)
# Set and print in one line using round-trip behavior
puts "\n=== Complex Number Tests ==="
puts "R10 = [reg 10 {1 + ix2}]"
puts "R11 = [reg 11 {3 + ix4}]"
puts "R12 = [reg 12 {5 - ix3}]"

# Test var command with complex numbers
var z1 "7 + ix9"
puts "Variable z1 = [var z1]"

# Overwrite real variable with complex (using round-trip)
puts "Overwritten rw2 (was real, now complex) = [var rw2 {10 - ix11}]"

# --- Date and Time Tests ---
# T47 tries data types in documented order: date, time, short int, long int, complex, real, string
# This means YYYY-MM-DD is parsed as a date, not as a real number
puts "\n=== Date and Time Tests ==="
puts "Date ISO format (YYYY-MM-DD): [reg 20 {2024-06-21}]"
puts "Time ISO format (HH:MM:SS): [reg 21 {18:30:45}]"

# Negative years are supported for dates before the common era
puts "Negative year date: [var negdate {-0001-03-15}]"

# Fractional seconds can be parsed but round to nearest second when displayed
puts "Time with fractional seconds (rounded): [reg 22 {23:45:59.7}]"

