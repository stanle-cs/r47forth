# Demonstration of reg, var, and flag commands for T47 DSL

# --- Register Get/Set Operations ---

reg 00 "1.234"
puts "Register 00 contains: [reg 00]"

puts "New value set: [reg 00 "5.678"]"

reg A "42"
puts "RA = [reg A]"

# --- Variable Get/Set Operations ---

var "myvalue" "3.14159"
puts "Named variable myvalue = [var myvalue]"

puts "New value set: [var myvalue "2.718"]"

var B "100"
puts "RB = [var B]"

# --- Flag Get/Set Operations ---

set f0 [flag 0]
puts "Flag 0 state: $f0"

set new_flag [flag 5 1]
puts "New flag 5 state: $new_flag"

set cleared [flag 5 0]

# --- Summary Output ---
puts "\n=== Final State ==="
puts "R00: [reg 00]"
puts "RA:  [reg A]"
puts "RB:  [reg B]"
puts "myvalue: [var myvalue]"
puts "Flag 5: [flag 5]"

# --- Complex Number Tests ---
puts "\n=== Complex Number Tests ==="
puts "R10 = [reg 10 {1 + ix2}]"
puts "R11 = [reg 11 {3 + ix4}]"
puts "R12 = [reg 12 {5 - ix3}]"

var z1 "7 + ix9"
puts "Variable z1 = [var z1]"

puts "Overwritten rw2 (was real, now complex) = [var rw2 {10 - ix11}]"

# --- Short Integer Tests ---
# Format: NNN#bb where NNN is the integer and bb is base 2-16
puts "\n=== Short Integer Tests ==="
puts "Hex FF in base 16: [reg 10 {FF#16}]"
puts "Decimal 42 in base 10: [var myint {42#10}]"
puts "Octal 77 in base 8: [reg 11 {77#8}]"
puts "Binary 1010 in base 2: [reg 12 {1010#2}]"

# Negative numbers use two's complement
puts "Negative hex -A in base 16: [reg 13 {-A#16}]"

# --- Long Integer Tests ---
# Plain digit strings (no # suffix) are long integers
puts "\n=== Long Integer Tests ==="
var "l1" "1234567890"
puts "Small long int: [var l1]"

var "l2" "12345678901234567890"
puts "Medium long int (20 digits): [var l2]"

var "l3" "123456789012345678901234567890"
puts "Large long int (30 digits): [var l3]"

var "l4" "123456789012345678901234567891234567890123456789012345678900123456789012345678901234567890"
puts "Very arge long int (90 digits): [var l4]"

var "l5" ""
puts "Extremely large long int (900 digits): [var l5]"

# Negative long integers
var "lneg" "-999999999999999999999999999999"
puts "Negative long int: [var lneg]"

# --- Date Tests ---
puts "\n=== Date Tests ==="
puts "Date (YYYY-MM-DD): [reg 20 {2024-06-21}]"
puts "Negative year date: [var negdate {-0001-03-15}]"

# --- Time Tests ---
puts "\n=== Time Tests ==="
puts "Time (HH:MM:SS): [reg 21 {18:30:45}]"
puts "Time with rounding: [reg 22 {23:45:59.7}]"
